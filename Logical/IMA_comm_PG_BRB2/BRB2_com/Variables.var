VAR
	(* AsIMA DataObject i identifikator sesije. *)
	pDatObjName : UDINT;       (* Adresa naziva AsIMA DataObject konfiguracije. *)
	stationId : UDINT;         (* Identifikator master AsIMA sesije. *)

	(* Povratni statusi AsIMA poziva. *)
	statusInit : UINT;         (* Rezultat jednokratne AsIMA inicijalizacije. *)
	statusComm : UINT;         (* Rezultat ciklicnog AsIMA prenosa. *)
	statusClose : UINT;        (* Rezultat zatvaranja AsIMA sesije. *)

	(* Dijagnostika inicijalizacije i PV prenosa. *)
	errorInfo : imaInfoStruct; (* Dijagnostika neuspele inicijalizacije. *)
	connInfoPV : imaInfoStruct; (* Status i dijagnostika PV prenosa ka BRB2. *)
	connInfoAUX : imaInfoStruct; (* Status pomocnih AsIMA servisa. *)
	ResetCommunication : BOOL; (* HMI zahtev za ponovno otvaranje AsIMA sesije. *)
	ResetInProgress : BOOL; (* Ponovna inicijalizacija AsIMA sesije je u toku. *)
	ResetDone : BOOL; (* Poslednja HMI reinicijalizacija je uspesno zavrsena. *)
	ResetFault : BOOL; (* Poslednja HMI reinicijalizacija nije uspela. *)
END_VAR
