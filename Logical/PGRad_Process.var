VAR RETAIN
	PGRad : typPGRad; (* Retain procesni kontekst: Ctrl, Par i CmdRetain. *)
END_VAR

VAR
	AktivniUlazniProtok : REAL; (* Realni protok aktivnog izvora termalne vode [l/s]. *)
	Predata_Snaga : REAL; (* Ukupna snaga predata izmenjivacima [kW]. *)
	Snaga_grejanja_hotela : REAL; (* Snaga predata hotelskom grejanju [kW]. *)
	Snaga_sanitarnog_grejanja : REAL; (* Preostala snaga predata sanitarnom grejanju [kW]. *)
	DP_Izmejnivac : REAL; (* DeviceCtrl racuna diferencijalni pritisak velikog izmenjivaca [bar]. *)
	DP_strainer : REAL; (* DeviceCtrl racuna diferencijalni pritisak grubog filtera [bar]. *)
	NivoPrihvatniSud : REAL; (* DeviceCtrl racuna hidrostaticki nivo prihvatnog suda [m]. *)
	PID_Pu_PT : MTBasicsPID; (* PID petlja pumpi na izlazu iz prihvatnog tanka. *)
	PGRad_Cmd : typCmdPGRad; (* Neretentivni komandni vektor state masine. *)
	PGRad_AirRelease : typAirReleasePGRad; (* Runtime odzracivanje PV03/PV04. *)
END_VAR