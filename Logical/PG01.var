VAR
	(* PT publish vektor: PT Act, Sens i Ctrl podatke salje prema BRB2/HMI. *)
	PG01_Local : typPG01Syn; (* PT upisuje lokalni Act/Sens/Ctrl snapshot za BRB2 i HMI. *)

	(* BRB2 mirror vektor: prima se samo za sinoptiku i ne upravlja PT opremom. *)
	PG01_Remote : typPG01Syn; (* BRB2 upisuje udaljeni snapshot; PT ga koristi samo za prikaz. *)
END_VAR